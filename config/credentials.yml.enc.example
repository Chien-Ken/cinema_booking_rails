# ==============================================================================
# Credentials Template for CineGlass (Cinema Booking Rails)
# Run `rails credentials:edit` to apply these keys to config/credentials.yml.enc
# ==============================================================================

# Stripe API Keys (Payment Processing)
stripe:
  publishable_key: pk_test_your_publishable_key_here
  secret_key: sk_test_your_secret_key_here
  webhook_secret: whsec_your_webhook_signing_secret_here

# AWS S3 Credentials (Active Storage - Posters/Banners)
aws:
  access_key_id: AKIA_YOUR_AWS_ACCESS_KEY_ID
  secret_access_key: YOUR_AWS_SECRET_ACCESS_KEY
  region: ap-southeast-1
  bucket: cineglass-s3-bucket-name

# Secret key base for Rails application
secret_key_base: your_generated_secret_key_base_here