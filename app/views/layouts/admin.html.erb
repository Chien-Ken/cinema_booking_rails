<!DOCTYPE html>
<html>
  <head>
    <title>CineGlass Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# This is CRITICAL for Tailwind to work %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#0f172a] text-white font-sans">
    <div class="flex h-screen overflow-hidden">
      
      <aside class="w-64 bg-[#0f172a] border-r border-slate-800 flex flex-col">
        <div class="p-8">
          <h1 class="text-xl font-bold tracking-tighter uppercase">Admin Portal</h1>
          <p class="text-xs text-gray-500">Inventory Management</p>
        </div>

        <nav class="flex-1 px-4 space-y-2">
          <%= link_to admin_root_path, class: "flex items-center space-x-3 p-3 text-gray-400 hover:text-white hover:bg-slate-800 rounded-lg transition" do %>
            <span>Dashboard</span>
          <% end %>

          <%= link_to admin_theaters_path, class: "flex items-center space-x-3 p-3  text-white rounded-lg shadow-lg shadow-red-900/20" do %>
            <span>Theaters</span>
          <% end %>

          <%= link_to admin_movies_path, class: "flex items-center space-x-3 p-3  text-white rounded-lg shadow-lg shadow-red-900/20" do %>
            <span>Movies</span>
          <% end %>
        </nav>

        

        <div class="p-4 border-t border-slate-800">
           <div class="flex items-center space-x-3 text-sm">
             <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center">A</div>
             <div>
               <p class="font-medium text-white">Admin User</p>
               <p class="text-xs text-gray-500">Super Admin</p>
             </div>
           </div>
        </div>
      </aside>

      <main class="flex-1 overflow-y-auto bg-[#0f172a] p-10">
        <% if notice %>
            <div class="mb-4 p-4 bg-green-500/10 border border-green-500/50 text-green-500 rounded-lg">
                <%= notice %>
            </div>
            <% end %>

            <% if alert %>
            <div class="mb-4 p-4 bg-red-500/10 border border-red-500/50 text-red-500 rounded-lg">
                <%= alert %>
            </div>
            <% end %>
        <%= yield %>
      </main>

    </div>
  </body>
</html>