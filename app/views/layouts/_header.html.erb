<header class="bg-[#0b1120] text-gray-300 px-8 py-4 flex items-center justify-between shadow-lg">

  <h2 class="text-2xl font-black tracking-tighter text-[#f87171]">CINEGLASS</h2>

  <div class="relative flex-1 max-w-2xl mx-8" data-controller="search">
    <%= form_with url: search_path,
                  method: :get,
                  data: { turbo_frame: "search_results_frame" } do |f| %>

      <%= f.text_field :query,
          placeholder: t('layouts.header.search_placeholder'),
          class: "w-full bg-slate-900 border border-slate-700 rounded-full py-2 px-5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-red-400",
          data: { action: "input->search#update" },
          autocomplete: "off" %>
    <% end %>

    <div class="absolute top-full mt-2 w-full z-50">
      <turbo-frame id="search_results_frame"></turbo-frame>
    </div>
  </div>

  <div class="flex items-center gap-8">
    <nav class="flex items-center gap-6 text-sm font-medium"> 
      <%= link_to t('layouts.header.home'), root_path, 
                  class: "#{current_page?(root_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>        
      
      <%= link_to t('layouts.header.theaters'), theaters_path, 
                  class: "#{current_page?(theaters_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>
      
      <%= link_to t('layouts.header.my_bookings'), my_bookings_path, 
                  class: "#{current_page?(my_bookings_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>
      
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to t('layouts.header.admin'), admin_root_path, class: "text-red-400 font-bold hover:text-red-300 transition px-4" %>
      <% end %>
    </nav>

    <div class="flex items-center gap-6">
      
      <div class="flex items-center gap-2 border-r border-slate-700 pr-4">
        <%= link_to url_for(locale: :vi), 
                    class: "transition transform hover:scale-110 #{'opacity-40 hover:opacity-100' unless I18n.locale == :vi}", 
                    title: "Tiếng Việt" do %>
          <%= image_tag "flag_vi.png", class: "w-6 h-4 object-cover rounded shadow-sm border border-slate-600" %>
        <% end %>

        <%= link_to url_for(locale: :en), 
                    class: "transition transform hover:scale-110 #{'opacity-40 hover:opacity-100' unless I18n.locale == :en}", 
                    title: "English" do %>
          <%= image_tag "flag_en.png", class: "w-6 h-4 object-cover rounded shadow-sm border border-slate-600" %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <span class="text-gray-400 text-sm italic"><%= t('layouts.header.welcome', name: current_user.name) %></span>
    
        <%= link_to t('layouts.header.log_out'), logout_path, 
                    data: { turbo_method: :delete }, 
                    class: "text-gray-300 hover:text-white font-medium transition" %>
      <% else %>
        <%= link_to t('layouts.header.sign_in'), login_path, 
                    class: "text-gray-300 hover:text-white font-medium transition" %>
    
        <%= link_to t('layouts.header.sign_up'), signup_path, 
                    class: "bg-[#e11d48] hover:bg-[#be123c] text-white px-5 py-2 rounded-xl font-bold transition shadow-lg" %>
      <% end %>
    </div>

  </div>
</header>