<header class="bg-[#0b1120] text-gray-300 px-4 sm:px-8 py-4 sticky top-0 z-50 shadow-lg border-b border-slate-900" data-controller="navbar">
  <div class="container mx-auto flex items-center justify-between gap-4">

    <%# 1. LOGO %>
    <h2 class="text-2xl font-black tracking-tighter text-[#f87171] shrink-0">
      <%= link_to "CINEGLASS", root_path, class: "text-[#f87171] hover:text-red-300 transition" %>
    </h2>

    <%# 2. SEARCH BAR (Bản Desktop: Màn hình lớn hiện, màn hình nhỏ ẩn hẳn) %>
    <div class="hidden md:block relative flex-1 max-w-xl mx-4" data-controller="search">
      <%= form_with url: search_path, method: :get, data: { turbo_frame: "search_results_frame" } do |f| %>
        <%= f.text_field :query,
            placeholder: t('layouts.header.search_placeholder'),
            class: "w-full bg-slate-900 border border-slate-700 rounded-full py-2 px-5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-red-400",
            data: { action: "input->search#update" },
            autocomplete: "off" %>
      <% end %>
      <div class="absolute top-full mt-2 w-full z-50">
        <turbo-frame id="search_results_frame"></turbo-frame>
      </div>
    </div>

    <%# 3. RIGHT CONTROLS (Bản Desktop: Chứa nav, cờ ngôn ngữ, auth buttons) %>
    <div class="hidden lg:flex items-center gap-6">
      <nav class="flex items-center gap-6 text-sm font-medium"> 
        <%= link_to t('layouts.header.home'), root_path, 
                    class: "#{current_page?(root_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>        
        <%= link_to t('layouts.header.theaters'), theaters_path, 
                    class: "#{current_page?(theaters_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>
        <%= link_to t('layouts.header.my_bookings'), my_bookings_path, 
                    class: "#{current_page?(my_bookings_path) ? 'text-white border-b-2 border-[#f87171] pb-1' : 'hover:text-white transition'}" %>
        <% if user_signed_in? && current_user.admin? %>
          <%= link_to t('layouts.header.admin'), admin_root_path, class: "text-red-400 font-bold hover:text-red-300 transition px-2" %>
        <% end %>
      </nav>

      <div class="flex items-center gap-4 border-l border-slate-700 pl-4">
        <%# Cụm đổi ngôn ngữ %>
        <div class="flex items-center gap-2">
          <%= link_to url_for(locale: :vi), class: "transition transform hover:scale-110 #{'opacity-40' unless I18n.locale == :vi}", title: "Tiếng Việt" do %>
            <%= image_tag "flag_vi.png", class: "w-6 h-4 object-cover rounded shadow-sm border border-slate-600" %>
          <% end %>
          <%= link_to url_for(locale: :en), class: "transition transform hover:scale-110 #{'opacity-40' unless I18n.locale == :en}", title: "English" do %>
            <%= image_tag "flag_en.png", class: "w-6 h-4 object-cover rounded shadow-sm border border-slate-600" %>
          <% end %>
        </div>

        <%# Auth Actions %>
        <% if user_signed_in? %>
          <span class="text-gray-400 text-xs italic max-w-[120px] truncate"><%= t('layouts.header.welcome', name: current_user.name) %></span>
          <%= link_to t('layouts.header.log_out'), logout_path, data: { turbo_method: :delete }, class: "text-gray-300 hover:text-white text-sm font-medium transition" %>
        <% else %>
          <%= link_to t('layouts.header.sign_in'), login_path, class: "text-gray-300 hover:text-white text-sm font-medium transition" %>
          <%= link_to t('layouts.header.sign_up'), signup_path, class: "bg-[#e11d48] hover:bg-[#be123c] text-white text-sm px-4 py-2 rounded-xl font-bold transition shadow-lg whitespace-nowrap" %>
        <% end %>
      </div>
    </div>

    <%# 4. HAMBURGER BUTTON (Chỉ hiện trên điện thoại/máy tính bảng, ẩn ở Desktop lớn) %>
    <button data-action="click->navbar#toggle" class="flex lg:hidden text-gray-400 hover:text-white focus:outline-none transition p-2 ml-auto">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

  </div>

  <%# 5. MOBILE DROPDOWN MENU (Xổ xuống khi click hamburger) %>
  <div data-navbar-target="menu" class="hidden lg:hidden bg-[#0b1120] border-t border-slate-900 mt-4 pt-4 pb-2 space-y-4">
    
    <%# Thanh tìm kiếm trên bản Mobile %>
    <div class="relative w-full px-2" data-controller="search">
      <%= form_with url: search_path, method: :get, data: { turbo_frame: "search_results_mobile_frame" } do |f| %>
        <%= f.text_field :query,
            placeholder: t('layouts.header.search_placeholder'),
            class: "w-full bg-slate-900 border border-slate-700 rounded-full py-2 px-5 text-sm text-white focus:outline-none",
            data: { action: "input->search#update" },
            autocomplete: "off" %>
      <% end %>
      <div class="absolute top-full mt-2 w-full z-50 left-0 px-2">
        <turbo-frame id="search_results_mobile_frame"></turbo-frame>
      </div>
    </div>

    <%# Navigation Links Mobile %>
    <nav class="flex flex-col space-y-2 px-2">
      <%= link_to t('layouts.header.home'), root_path, class: "block py-2 text-sm font-medium hover:text-white transition #{'text-red-400 border-l-2 border-[#f87171] pl-2' if current_page?(root_path)}" %>
      <%= link_to t('layouts.header.theaters'), theaters_path, class: "block py-2 text-sm font-medium hover:text-white transition #{'text-red-400 border-l-2 border-[#f87171] pl-2' if current_page?(theaters_path)}" %>
      <%= link_to t('layouts.header.my_bookings'), my_bookings_path, class: "block py-2 text-sm font-medium hover:text-white transition #{'text-red-400 border-l-2 border-[#f87171] pl-2' if current_page?(my_bookings_path)}" %>
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to t('layouts.header.admin'), admin_root_path, class: "block py-2 text-sm font-bold text-red-400 hover:text-red-300 transition" %>
      <% end %>
    </nav>

    <%# Cụm chức năng phụ + Auth Mobile %>
    <div class="border-t border-slate-800 pt-4 flex flex-col gap-4 px-2">
      
      <div class="flex items-center gap-3">
        <span class="text-xs text-gray-500 font-bold uppercase tracking-wider">Language:</span>
        <%= link_to url_for(locale: :vi), class: "flex items-center gap-1 text-xs #{I18n.locale == :vi ? 'text-white font-bold' : 'opacity-50'}" do %>
          <%= image_tag "flag_vi.png", class: "w-5 h-3.5 object-cover rounded" %> VI
        <% end %>
        <%= link_to url_for(locale: :en), class: "flex items-center gap-1 text-xs #{I18n.locale == :en ? 'text-white font-bold' : 'opacity-50'}" do %>
          <%= image_tag "flag_en.png", class: "w-5 h-3.5 object-cover rounded" %> EN
        <% end %>
      </div>
    
     
      <div class="pt-2">
        <% if user_signed_in? %>
          <div class="flex flex-col gap-3 bg-slate-900 p-4 rounded-xl border border-slate-800">
            
            <span class="text-gray-400 text-sm italic">
              <%= t('layouts.header.welcome', name: current_user.name) %>
            </span>
        
            <div class="h-[1px] bg-slate-800 w-full"></div>
            <%= link_to t('layouts.header.log_out'), logout_path, 
                        data: { turbo_method: :delete }, 
                        class: "text-rose-500 hover:text-rose-400 text-sm font-bold uppercase transition block text-left" %>
          </div>
        <% else %>
          <div class="grid grid-cols-2 gap-3">
            <%= link_to t('layouts.header.sign_in'), login_path, class: "text-center text-gray-300 hover:text-white border border-slate-700 py-2.5 rounded-xl text-sm font-medium transition" %>
            <%= link_to t('layouts.header.sign_up'), signup_path, class: "text-center bg-[#e11d48] hover:bg-[#be123c] text-white py-2.5 rounded-xl text-sm font-bold transition shadow-lg" %>
          </div>
        <% end %>
      </div>

    </div>

  </div>
</header>