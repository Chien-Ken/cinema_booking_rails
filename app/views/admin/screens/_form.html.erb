<%= form_with(model: [:admin, screen], class: "space-y-6 bg-zinc-900 p-8 rounded-xl border border-zinc-800 shadow-2xl") do |f| %>
  <% if screen.errors.any? %>
    <div class="p-4 bg-red-900/30 border border-red-800 text-red-200 rounded-lg text-sm">
      <h2 class="font-bold mb-2"><%= pluralize(screen.errors.count, "error") %> prevented this screen from saving:</h2>
      <ul class="list-disc ml-5">
        <% screen.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Screen Name", class: "block text-sm font-medium text-zinc-400 mb-2" %>
    <%= f.text_field :name, 
        placeholder: "e.g., Rap IMAX or Gold Class", 
        class: "w-full bg-zinc-800 border border-zinc-700 text-white rounded-lg px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition" %>
  </div>

  <div>
    <%= f.label :theater_id, "Select Theater Location", class: "block text-sm font-medium text-zinc-400 mb-2" %>
    <div class="relative">
      <%= f.collection_select :theater_id, Theater.all, :id, :name, 
          { prompt: "Choose a theater building..." }, 
          { class: "w-full bg-zinc-800 border border-zinc-700 text-white rounded-lg px-4 py-3 appearance-none focus:ring-2 focus:ring-blue-500 outline-none transition cursor-pointer" } %>
      <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-zinc-500">
        <i class="fa-solid fa-chevron-down text-xs"></i>
      </div>
    </div>
  </div>

  <div class="pt-4 flex items-center gap-4">
    <%= f.submit (screen.new_record? ? "Create Screen" : "Update Screen"), 
        class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg shadow-blue-900/20 transition-all cursor-pointer" %>
    
    <%= link_to "Cancel", admin_screens_path, class: "text-zinc-500 hover:text-zinc-300 font-medium transition" %>
  </div>
<% end %>