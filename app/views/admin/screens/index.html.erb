<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white">Cinema Screens</h1>
    <%= link_to new_admin_screen_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition flex items-center gap-2" do %>
      <i class="fa-solid fa-plus text-sm"></i>
      <span>Add New Screen</span>
    <% end %>
  </div>

  <div class="bg-zinc-900 shadow-xl rounded-xl border border-zinc-800 overflow-hidden">
    <table class="min-w-full leading-normal">
      <thead>
        <tr class="bg-zinc-800 text-zinc-400 uppercase text-xs tracking-wider">
          <th class="py-4 px-6 text-left font-semibold">Screen Name</th>
          <th class="py-4 px-6 text-left font-semibold">Theater Location</th>
          <th class="py-4 px-6 text-center font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="text-zinc-300 text-sm">
        <% @screens.each do |screen| %>
          <tr class="border-b border-zinc-800 hover:bg-zinc-800/50 transition-colors">
            <td class="py-4 px-6 text-left whitespace-nowrap">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded bg-zinc-700 flex items-center justify-center mr-3 text-blue-400">
                  <i class="fa-solid fa-display"></i>
                </div>
                <span class="font-medium text-white"><%= screen.name %></span>
              </div>
            </td>
            <td class="py-4 px-6 text-left">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-zinc-500 text-xs"></i>
                <%= screen.theater.name %>
              </span>
            </td>
            <td class="py-4 px-6 text-center">
              <div class="flex items-center justify-center space-x-3">
                <%# Edit Icon %>
                <%= link_to edit_admin_screen_path(screen), 
                            class: "p-2 rounded-lg bg-zinc-800 hover:bg-blue-600/20 text-zinc-400 hover:text-blue-400 transition-all",
                            title: "Edit Screen" do %>
                   <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
                <% end %>

               
                <%= link_to admin_screen_path(screen), 
                  data: { turbo_method: :delete, turbo_confirm: 'Remove this screen?' }, 
                  class: "p-2 rounded-lg bg-zinc-800 hover:bg-red-600/20 text-zinc-400 hover:text-red-400 transition-all" do %>
                   <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>