<%# 1. Header Section %>
<div class="flex justify-between items-center mb-8">
  <h1 class="text-2xl font-bold text-white">Theater Management</h1>
  <%= link_to "+ Add New Theater", new_admin_theater_path, 
      class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition" %>
</div>

<%# 2. Stat Cards Section %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="bg-[#1e293b] p-6 rounded-xl border border-slate-700 shadow-lg">
    <p class="text-gray-400 uppercase text-xs font-bold tracking-wider">Total Theaters</p>
    <p class="text-3xl font-bold text-white mt-1"><%= @theaters.count %></p>
  </div>
  
  <div class="bg-[#1e293b] p-6 rounded-xl border border-slate-700 shadow-lg">
    <p class="text-gray-400 uppercase text-xs font-bold tracking-wider">Revenue</p>
    <p class="text-3xl font-bold text-purple-500 mt-1">1.2M</p>
  </div>
</div>

<%# 3. Data Table Section %>
<div class="bg-[#1e293b] rounded-xl border border-slate-700 overflow-hidden shadow-xl">
  <table class="w-full text-left border-collapse">
    <thead class="bg-slate-800/50 text-gray-400 text-xs uppercase tracking-wider">
      <tr>
        <th class="px-6 py-4 font-semibold">Name</th>
        <th class="px-6 py-4 font-semibold">Address</th>
        <th class="px-6 py-4 font-semibold">Phone</th>
        <th class="px-6 py-4 font-semibold text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-700">
      <% @theaters.each do |theater| %>
        <tr class="hover:bg-slate-800/30 transition group">
          <td class="px-6 py-4 text-white font-medium"><%= theater.name %></td>
          <td class="px-6 py-4 text-gray-400"><%= theater.address %></td>
          <td class="px-6 py-4 text-gray-400"><%= theater.phone %></td>
          
          <%# Actions column with horizontal icons %>
          <td class="px-6 py-4 text-right">
            <div class="flex justify-end items-center space-x-3">
              
              <%# Edit Icon %>
              <%= link_to edit_admin_theater_path(theater), class: "p-2 text-blue-400 hover:bg-blue-500/10 rounded-lg transition-colors", title: "Edit" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                </svg>
              <% end %>

              <%# Delete Icon %>
              <%= button_to admin_theater_path(theater), 
                method: :delete, 
                form: { data: { turbo_confirm: "Are you sure you want to delete #{theater.name}?" } }, 
                class: "p-2 text-red-400 hover:bg-red-500/10 rounded-lg transition-colors", 
                title: "Delete" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
              <% end %>

            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="flex justify-center mt-8 cineglass-pagination">
  <%= will_paginate @theaters, 
      inner_window: 1, 
      outer_window: 0, 
      previous_label: "←", 
      next_label: "→" %>
</div>