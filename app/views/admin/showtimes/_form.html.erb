<%= form_with(model: [:admin, showtime], class: "space-y-6 bg-zinc-900 p-8 rounded-xl border border-zinc-800 shadow-2xl") do |f| %>
  
  <% if showtime.errors.any? %>
    <div class="p-4 bg-red-900/30 border border-red-800 text-red-200 rounded-lg text-sm">
      <h2 class="font-bold mb-2"><%= pluralize(showtime.errors.count, "error") %> prevented this schedule from saving:</h2>
      <ul class="list-disc ml-5">
        <% showtime.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 1. Movie Selection %>
  <div>
    <%= f.label :movie_id, "Select Movie", class: "block text-sm font-medium text-zinc-400 mb-2" %>
    <%= f.collection_select :movie_id, @movies, :id, :title, 
        { prompt: "Which movie is playing?" }, 
        { class: "w-full bg-zinc-800 border border-zinc-700 text-white rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 transition" } %>
  </div>

  <%# 2. Screen Selection (Theater Name + Screen Name) %>
  <div>
    <%= f.label :screen_id, "Select Screen & Location", class: "block text-sm font-medium text-zinc-400 mb-2" %>
    <%= f.collection_select :screen_id, @screens, :id, :name_with_theater, 
        { prompt: "Where is it playing?" }, 
        { class: "w-full bg-zinc-800 border border-zinc-700 text-white rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 transition" } %>
    <p class="text-xs text-zinc-500 mt-2 italic">Format: [Theater Name] - [Screen Name]</p>
  </div>

  <%# 3. Start Time %>
  <div>
    <%= f.label :start_time, "Start Date & Time", class: "block text-sm font-medium text-zinc-400 mb-2" %>
    <%= f.datetime_field :start_time, 
        class: "w-full bg-zinc-800 border border-zinc-700 text-white rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500 transition color-scheme-dark" %>
  </div>

  <div class="pt-4 flex items-center gap-4">
    <%= f.submit (showtime.new_record? ? "Create Schedule" : "Update Schedule"), 
        class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg shadow-blue-900/20 transition-all cursor-pointer" %>
    
    <%= link_to "Cancel", admin_showtimes_path, class: "text-zinc-500 hover:text-zinc-300 font-medium" %>
  </div>
<% end %>