<%= form_with(model: [:admin, movie], class: "max-w-4xl mx-auto space-y-6 pb-12") do |f| %>
  
  <%# 1. Basic Information Card %>
  <div class="bg-[#1e293b] rounded-2xl border border-slate-700 p-6 shadow-xl">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-blue-500/20 p-2 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Basic Information</h3>
    </div>

    <div class="space-y-5">
      <div>
        <%= f.label :title, "Movie Title", class: "block text-sm text-gray-400 mb-2" %>
        <%= f.text_field :title, placeholder: "e.g. The Killer", class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :genre, class: "block text-sm text-gray-400 mb-2" %>
          <%= f.text_field :genre, placeholder: "Select or type genre", class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
        </div>
        <div>
          <%= f.label :release_date, class: "block text-sm text-gray-400 mb-2" %>
          <%= f.date_field :release_date, class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :description, class: "block text-sm text-gray-400 mb-2" %>
        <%= f.text_area :description, rows: 3, placeholder: "Brief overview of the movie...", class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>
    </div>
  </div>

  <%# 2. Production Details Card (Replacing Operational Details) %>
  <div class="bg-[#1e293b] rounded-2xl border border-slate-700 p-6 shadow-xl">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-purple-500/20 p-2 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Production Details</h3>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <%= f.label :director, class: "block text-sm text-gray-400 mb-2" %>
        <%= f.text_field :director, class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>
      <div>
        <%= f.label :actor, "Leading Actors", class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>
      <div>
        <%= f.label :duration_minutes, "Duration (min)", class: "block text-sm text-gray-400 mb-2" %>
        <%= f.number_field :duration_minutes, class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>
      <div>
        <%= f.label :rating, "IMDb Rating", class: "block text-sm text-gray-400 mb-2" %>
        <%= f.number_field :rating, step: 0.1, class: "w-full bg-[#0f172a] border-slate-700 rounded-xl text-white p-3 focus:ring-2 focus:ring-red-500 outline-none" %>
      </div>
      
      <div class="mb-4">
      <%= f.label :price, class: "block text-sm font-medium text-gray-700" %>
      <div class="mt-1 relative rounded-md shadow-sm">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-500 sm:text-sm">$</span>
        </div>
        <%= f.number_field :price, 
              step: :any, 
              class: "pl-7 block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500", 
              placeholder: "0.00" %>
      </div>
    </div>

    </div>
  </div>

  <%# 3. Poster Image Card %>
  <div class="bg-[#1e293b] rounded-2xl border border-slate-700 p-6 shadow-xl">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-emerald-500/20 p-2 rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white">Movie Poster</h3>
    </div>

    <div class="relative border-2 border-dashed border-slate-700 rounded-2xl p-8 flex flex-col items-center justify-center bg-slate-900/50 group hover:border-blue-500/50 transition-colors">
      <% if movie.poster.attached? %>
        <%= image_tag movie.poster.variant(resize_to_limit: [400, 400]), class: "mb-4 rounded-lg max-h-48 shadow-lg" %>
      <% end %>
      
      <div class="text-center">
        <div class="bg-slate-800 p-3 rounded-full inline-block mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
        </div>
        <p class="text-white font-medium">Click to upload or drag and drop</p>
        <p class="text-xs text-gray-500 mt-1">Supported formats: JPG, PNG, WEBP (Max 5MB)</p>
      </div>
      <%= f.file_field :poster, class: "absolute inset-0 opacity-0 cursor-pointer" %>
    </div>
  </div>

  <%# 4. Action Buttons %>
  <div class="space-y-3">
    <%= f.submit movie.new_record? ? "💾 CREATE NEW MOVIE" : "💾 UPDATE MOVIE", 
        class: "w-full bg-red-600 hover:bg-red-700 text-white font-bold py-4 rounded-xl transition shadow-lg shadow-red-900/20 cursor-pointer uppercase tracking-wider" %>
    
    <%= link_to "Cancel & Discard", admin_movies_path, class: "block w-full text-center py-4 text-gray-500 hover:text-white transition font-medium" %>
  </div>

<% end %>