<%# This is the "Wrapper" that talks to Stimulus %>
<div class="min-h-screen bg-zinc-950 text-white py-12"
     data-controller="payment"
     data-payment-publishable-key-value="<%= Rails.application.credentials.stripe[:publishable_key] %>"
     data-payment-client-secret-value="<%= @intent.client_secret %>">

  <div class="max-w-7xl mx-auto px-4 mb-8">
    <div class="grid lg:grid-cols-12 gap-12">
      
      <%# Left Side: Your Form Partial %>
      <div class="lg:col-span-7">
         <%= render 'header'%>
        <%= render 'form', total: @total_price %>
      </div>

      <%# Right Side: Your Summary Partial %>
      <div class="lg:col-span-5">
        <%= render 'summary', 
                   movie: @movie, 
                   showtime: @showtime, 
                   seats: @seat_ids, 
                   total: @total_price %>
      </div>

    </div>
  </div>
</div>