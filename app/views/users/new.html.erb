<!-- Main Container with Theater Background -->
<div class="min-h-screen flex items-center justify-center bg-cover bg-center bg-no-repeat relative" 
     style="background-image: url('https://news.cgtn.com/news/2025-11-18/Release-of-Japanese-films-postponed-in-China-1IoWg7apLTW/img/015edd5ef60146d8a89df423c684500c/015edd5ef60146d8a89df423c684500c.jpeg');">
  
  <!-- Dark Overlay -->
  <div class="absolute inset-0 bg-[#0b1120]/90"></div>

  <!-- Sign Up Card -->
  <div class="relative z-10 w-full max-w-md bg-[#161d2f]/80 backdrop-blur-xl border border-gray-800 rounded-3xl p-8 shadow-2xl mx-4">
    
    <div class="text-center mb-8">
      <h2 class="text-[#f87171] text-3xl font-black tracking-tighter mb-1">CINEGLASS</h2>
      <p class="text-gray-400 text-sm">Create your premium movie pass</p>
    </div>

    <!-- Mock Form using standard HTML -->
    <form action="#" method="GET" class="space-y-5">
      
      <!-- Full Name -->
      <div class="space-y-2">
        <label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Full Name</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          </span>
          <input type="text" placeholder="John Doe" class="w-full pl-11 pr-4 py-3 bg-[#0b1120] border border-gray-700 rounded-xl text-white text-sm focus:ring-2 focus:ring-[#e11d48] focus:border-transparent outline-none transition">
        </div>
      </div>

      <!-- Email -->
      <div class="space-y-2">
        <label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Email Address</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </span>
          <input type="email" placeholder="name@example.com" class="w-full pl-11 pr-4 py-3 bg-[#0b1120] border border-gray-700 rounded-xl text-white text-sm focus:ring-2 focus:ring-[#e11d48] focus:border-transparent outline-none transition">
        </div>
      </div>

      <!-- Password -->
      <div class="space-y-2">
        <label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Password</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
          </span>
          <input type="password" placeholder="••••••••" class="w-full pl-11 pr-4 py-3 bg-[#0b1120] border border-gray-700 rounded-xl text-white text-sm focus:ring-2 focus:ring-[#e11d48] focus:border-transparent outline-none transition">
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="space-y-2">
        <label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Confirm Password</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </span>
          <input type="password" placeholder="••••••••" class="w-full pl-11 pr-4 py-3 bg-[#0b1120] border border-gray-700 rounded-xl text-white text-sm focus:ring-2 focus:ring-[#e11d48] focus:border-transparent outline-none transition">
        </div>
      </div>

      <!-- Terms -->
      <div class="flex items-start gap-3 pt-2">
        <input type="checkbox" class="mt-1 rounded border-gray-700 bg-[#0b1120] text-[#e11d48] focus:ring-[#e11d48]">
        <label class="text-[11px] text-gray-400">
          I agree to the <span class="text-[#fbbf24] cursor-pointer hover:underline">Terms & Conditions</span> and <span class="text-[#fbbf24] cursor-pointer hover:underline">Privacy Policy</span>.
        </label>
      </div>

      <!-- Submit -->
      <button type="submit" class="w-full py-4 bg-[#e11d48] hover:bg-[#be123c] text-white font-bold rounded-xl shadow-lg transition transform active:scale-[0.98] cursor-pointer mt-4">
        Sign Up →
      </button>

    </form>

    <div class="mt-8 pt-6 border-t border-gray-800 text-center">
      <p class="text-xs text-gray-500">
        Already have an account? 
        <a href="#" class="text-[#f87171] font-bold hover:underline">Sign In</a>
      </p>
    </div>

  </div>
</div>