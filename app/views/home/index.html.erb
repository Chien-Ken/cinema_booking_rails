<!-- Reduced height to 450px to let the next section peek through -->
<section class="relative h-[400px] w-full flex items-center bg-black overflow-hidden">
  
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1614850523296-d8c1af93d400?q=80&w=2070&auto=format&fit=crop" 
         class="w-full h-full object-cover opacity-50" alt="Neon Drift Background">
    <div class="absolute inset-0 bg-gradient-to-r from-[#0b1120] via-[#0b1120]/40 to-transparent"></div>
    <!-- Added a bottom gradient to blend into the movie list -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0b1120] via-transparent to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="max-w-xl space-y-4"> <!-- Reduced spacing -->
      
      <div class="flex items-center gap-2 text-[#fbbf24] text-xs font-bold uppercase tracking-widest">
        <span>🔥</span> Trending Now
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tighter leading-tight">
        NEON DRIFT: <br> ORIGINS
      </h1>

      <p class="text-gray-400 text-sm md:text-base leading-relaxed line-clamp-2"> <!-- Clamped text to save space -->
        In a world where memories are traded like currency, one rogue pilot discovers 
        a secret that could collapse the digital empire of Neo-Tokyo.
      </p>

      <div class="flex items-center gap-4 pt-2">
        <%= link_to "#", class: "bg-[#e11d48] hover:bg-[#be123c] text-white px-6 py-2 rounded-lg font-bold flex items-center gap-2 transition shadow-lg text-sm" do %>
          Book Now
        <% end %>
        <%= link_to "Watch Trailer", "#", class: "bg-white/10 hover:bg-white/20 backdrop-blur-md text-white px-6 py-2 rounded-lg font-bold transition text-sm border border-white/10" %>
      </div>
    </div>
  </div>

</section>

<!-- Movie List Section -->
<section class="py-12 bg-[#0b1120]">
  <div class="container mx-auto px-6 md:px-12">
    
    <!-- Tab Navigation & Filter -->
    <div class="flex items-center justify-between border-b border-gray-800 mb-8">
      <div class="flex gap-8 text-lg font-bold">
        <button class="text-white border-b-4 border-[#e11d48] pb-3">Now Showing</button>
        <button class="text-gray-500 hover:text-white transition pb-3">Coming Soon</button>
      </div>
      
      <button class="flex items-center gap-2 text-gray-400 hover:text-[#f87171] transition text-sm">
        <span>Filter & Sort</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
      </button>
    </div>

    <!-- Movie Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 mb-12">
      <%# Replace with @movies.each when ready %>
      <% [
        {title: "Stellar Horizon", rating: "4.8", genre: "Sci-Fi", duration: "2h 15m"},
        {title: "Velocity Zero", rating: "4.5", genre: "Action", duration: "1h 45m"},
        {title: "The Last Witness", rating: "4.9", genre: "Noir", duration: "2h 05m"},
        {title: "Spirit of the Wild", rating: "4.7", genre: "Animation", duration: "1h 35m"},
        {title: "Shadow Echoes", rating: "4.2", genre: "Horror", duration: "1h 52m"},
        {title: "The killer", rating: "4.2", genre: "Horror", duration: "1h 52m"},
        {title: "god of gambler", rating: "4.2", genre: "Horror", duration: "1h 52m"}
      ].each do |movie| %>
        <div class="group relative">
          <!-- Poster -->
          <div class="aspect-[2/3] rounded-2xl overflow-hidden bg-gray-900 shadow-xl transition-transform duration-300 group-hover:scale-105 border border-gray-800">
            <img src="https://media.themoviedb.org/t/p/w780/tJao1qKLYMKzyOvLHxxHeV6Jxzc.jpg" alt="<%= movie[:title] %>" class="w-full h-full object-cover opacity-80 group-hover:opacity-100">
            
            <!-- Rating Overlay -->
            <div class="absolute bottom-12 left-3 bg-black/70 backdrop-blur-md px-2 py-1 rounded-md border border-white/10 flex items-center gap-1">
              <span class="text-[#fbbf24] text-xs">★</span>
              <span class="text-white text-[11px] font-bold tracking-tighter"><%= movie[:rating] %></span>
              <span class="text-gray-400 text-[10px] ml-1"><%= movie[:genre] %> • <%= movie[:duration] %></span>
            </div>

            <!-- Title Overlay (Matches Image) -->
            <div class="absolute bottom-4 left-3 right-3">
              <h4 class="text-white font-bold text-sm truncate drop-shadow-md"><%= movie[:title] %></h4>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- will_paginate Styling -->
      <!-- will_paginate pending -->
    <div class="flex justify-center mt-8">
      <nav class="flex items-center gap-2">
        <button class="p-2 rounded-lg bg-gray-800 text-gray-500 hover:text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"/></svg></button>
        <button class="w-10 h-10 rounded-lg bg-[#e11d48] text-white font-bold text-sm">1</button>
        <button class="w-10 h-10 rounded-lg bg-gray-800 text-gray-400 hover:text-white text-sm">2</button>
        <button class="w-10 h-10 rounded-lg bg-gray-800 text-gray-400 hover:text-white text-sm">3</button>
        <span class="text-gray-600">...</span>
        <button class="w-10 h-10 rounded-lg bg-gray-800 text-gray-400 hover:text-white text-sm">12</button>
        <button class="p-2 rounded-lg bg-gray-800 text-gray-500 hover:text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
      </nav>
    </div>

  </div>
</section>