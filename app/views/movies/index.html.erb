<section class="relative h-[400px] w-full flex items-center bg-black overflow-hidden">
  <div class="absolute inset-0 z-0">
    <img src="https://images.unsplash.com/photo-1614850523296-d8c1af93d400?q=80&w=2070&auto=format&fit=crop" 
         class="w-full h-full object-cover opacity-50" alt="Neon Drift Background">
    <div class="absolute inset-0 bg-linear-to-r from-[#0b1120] via-[#0b1120]/40 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-r from-[#0b1120] via-transparent to-transparent"></div>
  </div>

  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <div class="max-w-xl space-y-4">
      <div class="flex items-center gap-2 text-[#fbbf24] text-xs font-bold uppercase tracking-widest">
        <span>🔥</span> <%= t('movies.index.trending') %>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tighter leading-tight">
        <%= t('movies.index.trending_title') %>
      </h1>
      <p class="text-gray-400 text-sm md:text-base leading-relaxed line-clamp-2">
        <%= t('movies.index.trending_desc') %>
      </p>
      <div class="flex items-center gap-4 pt-2">
        <%= link_to "#", class: "bg-[#e11d48] hover:bg-[#be123c] text-white px-6 py-2 rounded-lg font-bold flex items-center gap-2 transition shadow-lg text-sm" do %>
          <%= t('movies.index.book_now') %>
        <% end %>
        <%= link_to t('movies.index.watch_trailer'), "#", class: "bg-white/10 hover:bg-white/20 backdrop-blur-md text-white px-6 py-2 rounded-lg font-bold transition text-sm border border-white/10" %>
      </div>
    </div>
  </div>
</section>

<section class="py-12 bg-[#0b1120]">
  <div class="container mx-auto px-6 md:px-12">
    
    <div class="flex items-center justify-between border-b border-gray-800 mb-8">
      <div class="flex gap-8 text-lg font-bold">
      <%= link_to t('movies.index.now_showing'), root_path(filter: 'now_showing'), 
        class: "#{@active_tab == 'now_showing' ? 'text-white border-b-4 border-[#e11d48]' : 'text-gray-500 hover:text-white'} pb-3 transition-all" %>
    
      <%= link_to t('movies.index.coming_soon'), root_path(filter: 'coming_soon'), 
        class: "#{@active_tab == 'coming_soon' ? 'text-white border-b-4 border-[#e11d48]' : 'text-gray-500 hover:text-white'} pb-3 transition-all" %>
      </div>
      
      <button class="flex items-center gap-2 text-gray-400 hover:text-[#f87171] transition text-sm">
        <span><%= t('movies.index.filter_sort') %></span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
      </button>
    </div>

   <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 mb-12">
  <% @movies.each do |movie| %>
    <%= link_to movie_path(movie), class: "group relative block cursor-pointer" do %>
      
      <div class="aspect-[2/3] rounded-2xl overflow-hidden bg-gray-900 shadow-xl transition-all duration-300 group-hover:scale-105 border border-gray-800 group-hover:border-[#e11d48]/50 relative z-10">
        
        <% if movie.poster.attached? %>
          <%= image_tag movie.poster, 
              class: "w-full h-full object-cover transition-all duration-500 group-hover:brightness-110", 
              alt: movie.title %>
        <% else %>
          <div class="w-full h-full flex items-center justify-center bg-gray-800 text-gray-600 italic text-xs">
            <%= t('movies.index.no_poster') %>
          </div>
        <% end %>
        
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-20"></div>

        <div class="absolute bottom-12 left-3 bg-black/85 backdrop-blur-md px-2 py-1 rounded-md border border-white/10 flex items-center gap-1 z-30">
          <span class="text-[#fbbf24] text-xs">★</span>
          <span class="text-white text-[11px] font-bold tracking-tighter"><%= movie.rating %></span>
          <span class="text-gray-400 text-[10px] ml-1">
            <%= movie.genre %> • <%= t('movies.index.duration_short', minutes: movie.duration_minutes) %>
          </span>
        </div>

        <div class="absolute bottom-4 left-3 right-3 z-30">
          <h4 class="text-white font-bold text-sm truncate drop-shadow-md"><%= movie.title %></h4>
        </div>

      </div>

    <% end %>
  <% end %>
</div>

   <div class="flex justify-center mt-12 cineglass-pagination">
     <%= will_paginate @movies, inner_window: 1, outer_window: 0, previous_label: "←", next_label: "→" %>
   </div>

  </div>
</section>