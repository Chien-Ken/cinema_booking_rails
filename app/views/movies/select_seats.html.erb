<div class="min-h-screen bg-zinc-950 text-white p-4 md:p-8">
  <div class="max-w-full mx-auto lg:px-16" 
       data-controller="selection" 
       data-selection-price-value="<%= @movie.price %>"> 
    
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold"><%= @movie.title %></h1>
      <p class="text-zinc-400 mt-2 text-sm">
        <%= @showtime.screen.theater.name %> • <%= @showtime.screen.name %> • <%= @showtime.start_time.strftime("%I:%M %p") %>
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 items-start justify-between">
      
      <div class="w-full max-w-2xl">
        <div class="relative mb-16 px-10">
          <div class="w-full h-1.5 bg-blue-500 shadow-[0_-5px_20px_rgba(59,130,246,0.6)] rounded-full"></div>
          <p class="text-center text-[10px] text-zinc-600 uppercase tracking-widest mt-4">Theatrical Screen</p>
        </div>

        <div class="grid grid-cols-10 gap-3">
          <% @seats.each do |seat| %>
            <% is_booked = @booked_seats.include?(seat.id) %>
            <button 
              data-action="click->selection#toggle" 
              data-seat-id="<%= seat.id %>"
              data-seat-name="<%= seat.row %><%= seat.number %>"
              class="aspect-square flex items-center justify-center rounded-md text-[10px] font-bold transition-all border
                     <%= is_booked ? 'bg-zinc-800 border-zinc-800 text-zinc-600 cursor-not-allowed' : 'border-emerald-500 text-emerald-500 hover:bg-emerald-500 hover:text-white' %>"
              <%= 'disabled' if is_booked %>>
              <%= seat.row %><%= seat.number %>
            </button>
          <% end %>
        </div>

        <div class="mt-12 flex justify-center gap-8 text-[11px] border-t border-zinc-900 pt-8 uppercase tracking-wider text-zinc-500">
          <div class="flex items-center gap-2 text-emerald-500">
            <div class="w-3 h-3 border border-emerald-500 rounded-sm"></div> <span>Available</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 bg-zinc-800 rounded-sm"></div> <span>Booked</span>
          </div>
          <div class="flex items-center gap-2 text-red-500">
            <div class="w-3 h-3 bg-red-600 rounded-sm"></div> <span>Selected</span>
          </div>
        </div>
      </div> <aside class="w-full lg:w-96 sticky top-8">
        <%= render 'booking_summary' %>
      </aside>

    </div> </div> </div> 



