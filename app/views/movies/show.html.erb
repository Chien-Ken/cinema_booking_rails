<%# 1. Hero Header Section %>
<div class="relative min-h-[600px] flex items-center py-20 overflow-hidden bg-[#0f172a]">
  
  <%# --- GLOBAL BACKGROUND IMAGE --- %>
  <div class="absolute inset-0 z-0">
    <%# Replace 'background_cinema.jpg' with your actual background file name %>
    <%= image_tag "background_cinema.png", 
        class: "w-full h-full object-cover opacity-20" %>
    
    <%# Dark Gradient Overlay to ensure the background doesn't distract from the content %>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0f172a] via-[#0f172a]/70 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#0f172a] to-transparent"></div>
  </div>
  <%# ------------------------------- %>

  <div class="container mx-auto px-4 relative z-10">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      
      <%# Movie Poster Card (Remains in original position) %>
      <div class="w-full md:w-1/4 shrink-0">
        <div class="aspect-[2/3] rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.6)] border border-white/10 ring-1 ring-white/20">
          <% if @movie.poster.attached? %>
            <%= image_tag @movie.poster, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full bg-slate-800 flex items-center justify-center italic text-slate-500"><%= t('movies.show.no_poster') %></div>
          <% end %>
        </div>
      </div>

      <%# Movie Info Details %>
      <div class="flex-1 pt-6">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="bg-[#fbbf24] text-black text-[10px] font-black px-2 py-1 rounded uppercase tracking-wider">
            <%= @movie.genre %>
          </span>
          <span class="bg-white/10 text-white text-[10px] font-bold px-2 py-1 rounded border border-white/10">PG-13</span>
          <div class="flex items-center gap-1 ml-2">
            <span class="text-[#fbbf24]">★</span>
            <span class="text-white font-bold"><%= @movie.rating %></span>
          </div>
        </div>

        <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tighter uppercase leading-tight drop-shadow-2xl">
          <%= @movie.title %>
        </h1>

        <div class="flex flex-wrap gap-x-8 gap-y-4 text-slate-300 font-medium mb-6">
          <div class="flex items-center gap-2">
            <span class="text-slate-500 text-xs uppercase tracking-widest font-bold"><%= t('movies.show.runtime') %></span>
            <span><%= @movie.duration_minutes %>m</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 text-xs uppercase tracking-widest font-bold"><%= t('movies.show.released') %></span>
            <span><%= @movie.release_date.strftime(t('movies.show.date_format')) %></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 text-xs uppercase tracking-widest font-bold"><%= t('movies.show.director') %></span>
            <span class="text-red-500 font-bold hover:underline cursor-pointer"><%= @movie.director %></span>
          </div>
        </div>

        <%= link_to t('movies.show.book_now'), booking_movie_path(@movie), 
            class: "inline-block bg-[#e11d48] hover:bg-red-500 text-white font-black px-12 py-4 rounded-xl text-lg shadow-xl shadow-red-900/40 transition-all transform hover:scale-105 active:scale-95" %>
      </div>
    </div>
  </div>
</div>

<%# 2. Synopsis Section %>
<div class="container mx-auto px-4 py-16">
  <div class="max-w-4xl">
    <div class="flex items-center gap-4 mb-8">
      <div class="w-1.5 h-8 bg-red-500 rounded-full"></div>
      <h3 class="text-2xl font-black text-white tracking-tight"><%= t('movies.show.description_title') %></h3>
    </div>
    
    <div class="bg-white/5 border border-white/5 rounded-3xl p-8 md:p-12 leading-relaxed text-slate-400 text-lg shadow-inner">
      <%= @movie.description %>
    </div>

   
  </div>
</div>
